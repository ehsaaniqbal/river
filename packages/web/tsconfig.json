{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@river/engine": ["../engine/src/index.ts"],
      "@river/engine/*": ["../engine/src/*"],
      "@river/shared": ["../shared/src/index.ts"],
      "@river/shared/*": ["../shared/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
